@startuml
!define RECTANGLE class

skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam linetype ortho

title DTAgent CLI - 业务逻辑视图 (Business Logic View)

package "CLI Layer" #E8F4FD {
    [CLI Entry] as CLI <<bin/dtagent.js>>
}

package "Command Layer" #E8F8E8 {
    [Init Command] as INIT <<init.ts>>
    [Generate Command] as GEN <<generate.ts>>
    [Extract Experience] as EXT <<extract-experience.ts>>
}

package "Utils Layer" #FFF4E6 {
    [Framework Detector] as DET <<detector.ts>>
    [Dependency Manager] as DEP <<dependency.ts>>
    [CFR Decompiler] as CFR <<cfr.ts>>
    [Report Generator] as REP <<report.ts>>
}

package "External Systems" #FFE6E6 {
    [Maven/Gradle] as BUILD
    [OpenCode] as OPCODE
    [Java Process] as JAVA
    [File System] as FS
}

package "Output" #F0E6FF {
    [DT_AGENTS.md] as CONFIG
    [.opencode/] as OPDIR
    [.dtagent/deps/] as DEPS
    [Test Reports] as REPORTS
}

' CLI to Commands
CLI --> INIT : init
CLI --> GEN : generate
CLI --> EXT : extract-experience

' Commands to Utils
INIT --> DET : detect framework
INIT --> DEP : parse dependencies
INIT --> CFR : decompile JARs

GEN --> OPCODE : invoke generate-java-ut
GEN --> FS : scan/write files

EXT --> FS : read test files

' Utils to External
DET --> BUILD : read pom.xml/build.gradle
DEP --> BUILD : resolve dependencies
DEP --> FS : scan Maven repo
CFR --> JAVA : exec CFR jar
CFR --> FS : write decompiled

' Outputs
INIT --> CONFIG : generate
INIT --> OPDIR : install skills
INIT --> DEPS : store decompiled

GEN --> REPORTS : save results
@enduml